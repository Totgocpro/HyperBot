# POSTGRES_PASSWORD and REDIS_PASSWORD are generated automatically by Dev.sh, Release.sh, and Release.bat.
# Set them manually only if you do not use the provided scripts.
COMPOSE_PROJECT_NAME=""
POSTGRES_PASSWORD=""
REDIS_PASSWORD=""
POSTGRES_PASSWORD_URL_ENCODED=""
REDIS_PASSWORD_URL_ENCODED=""
SUPER_ADMIN_IDS=""
PUBLIC_REGISTRATION_ENABLED="true"
PLUGIN_DIRECTORY="Plugins"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ENABLE_MESSAGE_EVENTS="true"
FOLLOW_LOGS="true"
# Optional Temp Voice YouTube auth. Point to a Netscape cookies.txt file readable by the bot.
# Docker: use the path inside the container, for example /run/secrets/youtube-cookies.txt.
TEMPVOICE_YOUTUBE_COOKIES_PATH=""
YOUTUBE_COOKIES_PATH=""
# Optional. Leave empty for an automatic free dashboard port.
APP_HOST_BIND="127.0.0.1"
APP_HOST_PORT=""
DATABASE_HOST_BIND="127.0.0.1"
