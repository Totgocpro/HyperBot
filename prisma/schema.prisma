generator client {
  provider = "prisma-client-js"
}

datasource Database {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DashboardRole {
  SuperAdmin
  User
}

enum GuildAccessRole {
  GuildOwner
  GuildAdmin
}

model DashboardUser {
  Id                String         @id @default(cuid())
  DiscordId         String         @unique
  Username          String         @unique
  DisplayName       String
  PasswordHash      String
  PasswordSalt      String
  Role              DashboardRole  @default(User)
  IsDashboardBanned Boolean        @default(false)
  CreatedAt         DateTime       @default(now())
  UpdatedAt         DateTime       @updatedAt
  SessionTokens     SessionToken[]
  BotAccesses       BotAccess[]
}

model DiscordBot {
  Id            String   @id @default(cuid())
  ClientId      String   @unique
  Token         String   @unique
  Name          String
  AvatarUrl     String?
  IsEnabled     Boolean  @default(true)
  CreatedAt     DateTime @default(now())
  UpdatedAt     DateTime @updatedAt

  GuildAccesses      GuildAccess[]
  PluginConfigs      PluginGlobalConfig[]
  UserPluginValues   UserPluginValue[]
  GuildRoleGrants    GuildRoleGrant[]
  DisabledPlugins    BotDisabledPlugin[]
  BotAccesses        BotAccess[]
}

model BotAccess {
  Id        String        @id @default(cuid())
  UserId    String
  BotId     String
  CreatedAt DateTime      @default(now())
  User      DashboardUser @relation(fields: [UserId], references: [Id], onDelete: Cascade)
  Bot       DiscordBot    @relation(fields: [BotId], references: [Id], onDelete: Cascade)

  @@unique([UserId, BotId])
  @@index([UserId])
}

model BotDisabledPlugin {
  Id        String     @id @default(cuid())
  BotId     String
  PluginId  String
  Bot       DiscordBot @relation(fields: [BotId], references: [Id], onDelete: Cascade)

  @@unique([BotId, PluginId])
  @@index([BotId])
}

model SessionToken {
  Id              String        @id @default(cuid())
  UserId          String
  TokenHash       String
  RevokedAt       DateTime?
  CreatedAt       DateTime      @default(now())
  ExpiresAt       DateTime
  DashboardUser   DashboardUser @relation(fields: [UserId], references: [Id], onDelete: Cascade)

  @@index([UserId])
}

model GuildAccess {
  Id               String      @id @default(cuid())
  BotId            String
  GuildId          String
  IsAllowed        Boolean     @default(true)
  RestrictedReason String?
  CreatedAt        DateTime    @default(now())
  UpdatedAt        DateTime    @updatedAt
  Bot              DiscordBot  @relation(fields: [BotId], references: [Id], onDelete: Cascade)

  @@unique([BotId, GuildId])
  @@index([BotId])
}

model GuildRoleGrant {
  Id               String          @id @default(cuid())
  BotId            String
  GuildId          String
  DiscordId        String
  Role             GuildAccessRole
  AllowedPluginIds Json?
  CreatedAt        DateTime        @default(now())
  UpdatedAt        DateTime        @updatedAt
  Bot              DiscordBot      @relation(fields: [BotId], references: [Id], onDelete: Cascade)

  @@unique([BotId, GuildId, DiscordId])
  @@index([BotId])
  @@index([DiscordId])
}

model PluginGlobalConfig {
  Id        String     @id @default(cuid())
  BotId     String
  GuildId   String
  PluginId  String
  Key       String
  Value     Json
  CreatedAt DateTime   @default(now())
  UpdatedAt DateTime   @updatedAt
  Bot       DiscordBot @relation(fields: [BotId], references: [Id], onDelete: Cascade)

  @@unique([BotId, GuildId, PluginId, Key])
  @@index([BotId, GuildId, PluginId])
}

model UserPluginValue {
  Id        String     @id @default(cuid())
  BotId     String
  GuildId   String
  UserId    String
  PluginId  String
  Key       String
  Value     Json
  CreatedAt DateTime   @default(now())
  UpdatedAt DateTime   @updatedAt
  Bot       DiscordBot @relation(fields: [BotId], references: [Id], onDelete: Cascade)

  @@unique([BotId, GuildId, UserId, PluginId, Key])
  @@index([BotId, GuildId, UserId])
}

model SystemSetting {
  Key       String   @id
  Value     Json
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt
}

model AuditLog {
  Id        String   @id @default(cuid())
  BotId     String?
  ActorId   String
  Action    String
  Target    String
  Metadata  Json?
  CreatedAt DateTime @default(now())

  @@index([ActorId])
  @@index([BotId])
}
