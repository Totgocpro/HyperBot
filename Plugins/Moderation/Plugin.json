{
  "Metadata": {
    "Id": "Moderation",
    "DisplayName": "Moderation",
    "Version": "1.0.0",
    "Author": "HyperBot",
    "Icon": "Mod"
  },
  "Scope": "Guild",
  "Commands": [
    {
      "Name": "warn",
      "Description": "Warn a user and store the sanction.",
      "Options": [
        {
          "Name": "user",
          "Description": "User to warn.",
          "Type": "User",
          "Required": true
        },
        {
          "Name": "reason",
          "Description": "Reason for the warning.",
          "Type": "String",
          "Required": true
        }
      ]
    },
    {
      "Name": "lookup",
      "Description": "Show all known sanctions for a user.",
      "Options": [
        {
          "Name": "user",
          "Description": "User to inspect.",
          "Type": "User",
          "Required": true
        }
      ]
    }
  ],
  "WebInterface": [
    {
      "Key": "LogChannelId",
      "Type": "ChannelPicker",
      "Label": "Moderation log channel",
      "Default": "",
      "Section": "Log channel",
      "Required": true,
      "SupportedChannelTypes": [
        "GuildText",
        "GuildAnnouncement",
        "GuildForum",
        "GuildVoice"
      ],
      "RequireWritable": true
    },
    {
      "Key": "WarnMessage",
      "Type": "String",
      "Label": "Warn confirmation message",
      "Default": "%user% has been warned by %moderator%: %reason%",
      "Section": "Sanctions"
    },
    {
      "Key": "LogMessage",
      "Type": "String",
      "Label": "Sanction log message",
      "Default": "%type% applied to %user% by %moderator%: %reason%",
      "Section": "Sanctions"
    },
    {
      "Key": "DeletedMessageLog",
      "Type": "String",
      "Label": "Deleted message log",
      "Default": "Message deleted in %channel% from %user%: %content%",
      "Section": "Message logs"
    },
    {
      "Key": "EditedMessageLog",
      "Type": "String",
      "Label": "Edited message log",
      "Default": "Message edited in %channel% from %user%: before `%old%` after `%new%`",
      "Section": "Message logs"
    },
    {
      "Key": "MemberJoinLog",
      "Type": "String",
      "Label": "Member join log",
      "Default": "%user% joined the server.",
      "Section": "Member logs"
    },
    {
      "Key": "MemberLeaveLog",
      "Type": "String",
      "Label": "Member leave log",
      "Default": "%user% left the server.",
      "Section": "Member logs"
    },
    {
      "Key": "AutoModEnabled",
      "Type": "Boolean",
      "Label": "Enable AutoMod regex rules",
      "Default": false,
      "Section": "Regex AutoMod"
    },
    {
      "Key": "AutoModRegexPatterns",
      "Type": "List",
      "ItemType": "String",
      "ValidateAs": "Regex",
      "Label": "AutoMod regex patterns",
      "Default": [],
      "Section": "Regex AutoMod"
    },
    {
      "Key": "AutoModAction",
      "Type": "Select",
      "Label": "AutoMod action",
      "Default": "DeleteAndWarn",
      "Section": "Regex AutoMod",
      "Options": [
        {
          "Label": "Delete message",
          "Value": "Delete"
        },
        {
          "Label": "Warn user",
          "Value": "Warn"
        },
        {
          "Label": "Delete and warn",
          "Value": "DeleteAndWarn"
        }
      ]
    },
    {
      "Key": "AutoModReason",
      "Type": "String",
      "Label": "AutoMod warn reason",
      "Default": "Message matched AutoMod rule: %pattern%",
      "Section": "Regex AutoMod"
    },
    {
      "Key": "AutoModLogMessage",
      "Type": "String",
      "Label": "AutoMod log message",
      "Default": "AutoMod matched %user% in %channel% with `%pattern%`: %content%",
      "Section": "Regex AutoMod"
    },
    {
      "Key": "RepeatedSpamEnabled",
      "Type": "Boolean",
      "Label": "Detect repeated message spam",
      "Default": false,
      "Section": "Repeated spam"
    },
    {
      "Key": "RepeatedSpamWindowSeconds",
      "Type": "Number",
      "Label": "Repeated spam window seconds",
      "Default": 10,
      "Section": "Repeated spam"
    },
    {
      "Key": "RepeatedSpamThreshold",
      "Type": "Number",
      "Label": "Repeated spam threshold",
      "Default": 3,
      "Section": "Repeated spam"
    },
    {
      "Key": "RepeatedSpamAction",
      "Type": "Select",
      "Label": "Repeated spam action",
      "Default": "DeleteAndWarn",
      "Section": "Repeated spam",
      "Options": [
        {
          "Label": "Delete message",
          "Value": "Delete"
        },
        {
          "Label": "Warn user",
          "Value": "Warn"
        },
        {
          "Label": "Delete and warn",
          "Value": "DeleteAndWarn"
        }
      ]
    },
    {
      "Key": "InviteBlockEnabled",
      "Type": "Boolean",
      "Label": "Block invites to other servers",
      "Default": false,
      "Section": "Invite blocking"
    },
    {
      "Key": "AllowedInviteCodes",
      "Type": "List",
      "ItemType": "String",
      "Label": "Allowed invite codes",
      "Default": [],
      "Section": "Invite blocking"
    },
    {
      "Key": "InviteBlockAction",
      "Type": "Select",
      "Label": "Invite block action",
      "Default": "DeleteAndWarn",
      "Section": "Invite blocking",
      "Options": [
        {
          "Label": "Delete message",
          "Value": "Delete"
        },
        {
          "Label": "Warn user",
          "Value": "Warn"
        },
        {
          "Label": "Delete and warn",
          "Value": "DeleteAndWarn"
        }
      ]
    },
    {
      "Key": "InviteBlockReason",
      "Type": "String",
      "Label": "Invite block warn reason",
      "Default": "Invite links to other servers are not allowed: %invite%",
      "Section": "Invite blocking"
    },
    {
      "Key": "InviteBlockLogMessage",
      "Type": "String",
      "Label": "Invite block log message",
      "Default": "Blocked invite from %user% in %channel%: %invite%",
      "Section": "Invite blocking"
    },
    {
      "Key": "ReplaceWordEnabled",
      "Type": "Boolean",
      "Label": "Enable word replacement",
      "Default": false,
      "Section": "Message rewriting"
    },
    {
      "Key": "ReplaceWordRules",
      "Type": "List",
      "ItemType": "String",
      "Label": "Word replacement rules",
      "Default": [],
      "Section": "Message rewriting"
    },
    {
      "Key": "CensorWordEnabled",
      "Type": "Boolean",
      "Label": "Enable word censorship",
      "Default": false,
      "Section": "Message rewriting"
    },
    {
      "Key": "CensorWords",
      "Type": "List",
      "ItemType": "String",
      "Label": "Words to censor",
      "Default": [
        "fuck",
        "fucking",
        "shit",
        "bitch",
        "bastard",
        "asshole",
        "kill",
        "murder",
        "suicide",
        "terrorist",
        "bomb",
        "rape",
        "violate"
      ],
      "Section": "Message rewriting"
    },
    {
      "Key": "RewriteWarnUser",
      "Type": "Boolean",
      "Label": "Warn after message rewrite",
      "Default": false,
      "Section": "Message rewriting"
    },
    {
      "Key": "RewriteWarnReason",
      "Type": "String",
      "Label": "Rewrite warn reason",
      "Default": "Message cleaned by moderation: %words%",
      "Section": "Message rewriting"
    },
    {
      "Key": "RewriteLogMessage",
      "Type": "String",
      "Label": "Rewrite log message",
      "Default": "Cleaned message from %user% in %channel%: `%old%` -> `%new%`",
      "Section": "Message rewriting"
    }
  ],
  "EntryPoint": "./ModerationPlugin.ts",
  "Category": "Moderation"
}
