      "Default": 3,
      "Section": "Activity status"
    },
    {
      "Key": "LowActivityVoiceMinuteThreshold",
      "Type": "Number",
      "Label": "Low activity voice minute threshold",
      "Default": 10,
      "Section": "Activity status"
    },
    {
      "Key": "LowActivityReactionThreshold",
      "Type": "Number",
      "Label": "Low activity reaction threshold",
      "Default": 2,
      "Section": "Activity status"
    },
    {
      "Key": "ActiveRoleId",
      "Type": "RolePicker",
      "Label": "Active member role",
      "Default": "",
      "Section": "Activity roles"
    },
    {
      "Key": "InactiveRoleId",
      "Type": "RolePicker",
      "Label": "Inactive member role",
      "Default": "",
      "Section": "Activity roles"
    },
    {
      "Key": "StatsEmbed",
      "Type": "EmbedEditor",
      "Label": "Stats command embed",
      "Description": "Available tags: %user%, %messages_today%, %messages_week%, %messages_month%, %messages_all%, %voice_today%, %voice_week%, %voice_month%, %voice_year%, %voice_all%.",
      "Default": {
        "Name": "Stats command",
        "Title": "%user%'s statistics",
        "Description": "",
        "Color": "#3b82f6",
        "Url": "",
        "AuthorName": "",
        "AuthorIconUrl": "",
        "ThumbnailUrl": "%avatar%",
        "ImageUrl": "",
        "FooterText": "Statistics are tracked from the moment the plugin version with user stats is active.",
        "FooterIconUrl": "",
        "Timestamp": true,
        "Fields": [
          {
            "Name": "Messages",
            "Value": "Today: **%messages_today%**\nThis week: **%messages_week%**\nThis month: **%messages_month%**\nAll-time: **%messages_all%**",
            "Inline": true
          },
          {
            "Name": "Voice time",
            "Value": "Today: **%voice_today%**\nThis week: **%voice_week%**\nThis month: **%voice_month%**\nThis year: **%voice_year%**\nAll-time: **%voice_all%**",
