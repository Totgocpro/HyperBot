{
  "Metadata": {
    "Id": "Statistics",
    "DisplayName": "Statistics",
    "Version": "1.0.0",
    "Author": "HyperBot",
    "Icon": "Stats"
  },
  "Scope": "Guild",
  "Commands": [
    {
      "Name": "stats",
      "Description": "Show your server statistics"
    }
  ],
  "WebInterface": [
    {
      "Key": "TrackBots",
      "Type": "Boolean",
      "Label": "Include bot accounts in statistics",
      "Default": false,
      "Section": "Tracking"
    },
    {
      "Key": "IgnoredVoiceChannelIds",
      "Type": "List",
      "Label": "Ignored voice channels",
      "Default": [],
      "Section": "Tracking",
      "ItemType": "ChannelPicker",
      "SupportedChannelTypes": [
        "GuildVoice"
      ]
    },
    {
      "Key": "StatsEmbed",
      "Type": "EmbedEditor",
      "Label": "Stats command embed",
      "Description": "Available tags: %user%, %messages_today%, %messages_week%, %messages_month%, %messages_all%, %voice_today%, %voice_week%, %voice_month%, %voice_year%, %voice_all%.",
      "Default": {
        "Name": "Stats command",
        "Title": "%user%'s statistics",
        "Description": "",
        "Color": "#3b82f6",
        "Url": "",
        "AuthorName": "",
        "AuthorIconUrl": "",
        "ThumbnailUrl": "%avatar%",
        "ImageUrl": "",
        "FooterText": "Statistics are tracked from the moment the plugin version with user stats is active.",
        "FooterIconUrl": "",
        "Timestamp": true,
        "Fields": [
          {
            "Name": "Messages",
            "Value": "Today: **%messages_today%**\nThis week: **%messages_week%**\nThis month: **%messages_month%**\nAll-time: **%messages_all%**",
            "Inline": true
          },
          {
            "Name": "Voice time",
            "Value": "Today: **%voice_today%**\nThis week: **%voice_week%**\nThis month: **%voice_month%**\nThis year: **%voice_year%**\nAll-time: **%voice_all%**",
            "Inline": true
          }
        ],
        "ImageDataUrl": "",
        "ImageName": ""
      },
      "Section": "Stats command"
    },
    {
      "Key": "ChannelCounters",
      "Type": "List",
      "ItemType": "String",
      "Label": "Channel counters",
      "Default": [],
      "Section": "Channel counters",
      "SupportedChannelTypes": [
        "GuildVoice"
      ]
    }
  ],
  "DashboardElements": [
    {
      "Key": "MessagesChart",
      "Type": "BarChart",
      "Label": "Messages sent",
      "DataSourceKey": "MessagesDaily",
      "Unit": "messages"
    },
    {
      "Key": "VoiceTimeChart",
      "Type": "LineChart",
      "Label": "Voice time",
      "DataSourceKey": "VoiceSecondsDaily",
      "Unit": "seconds"
    },
    {
      "Key": "JoinsChart",
      "Type": "BarChart",
      "Label": "Members joined",
      "DataSourceKey": "JoinsDaily",
      "Unit": "joins"
    },
    {
      "Key": "LeavesChart",
      "Type": "BarChart",
      "Label": "Members left",
      "DataSourceKey": "LeavesDaily",
      "Unit": "leaves"
    },
    {
      "Key": "MessagesActivityHeatmap",
      "Type": "ActivityHeatmap",
      "Label": "Message activity heatmap",
      "DataSourceKey": "MessagesHourly",
      "Unit": "messages"
    },
    {
      "Key": "VoiceActivityHeatmap",
      "Type": "ActivityHeatmap",
      "Label": "Voice activity heatmap",
      "DataSourceKey": "VoiceSecondsHourly",
      "Unit": "seconds"
    }
  ],
  "EntryPoint": "./StatisticsPlugin.ts",
  "Category": "Analytics"
}
