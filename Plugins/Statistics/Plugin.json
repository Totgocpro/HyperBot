{
  "Metadata": {
    "Id": "Statistics",
    "DisplayName": "Statistics",
    "Version": "1.0.0",
    "Author": "HyperBot",
    "Icon": "FiBarChart2"
  },
  "Scope": "Guild",
  "Help": {
    "Description": "Tracks messages, reactions, voice time, joins, leaves, channel counters, and member activity status."
  },
  "Commands": [
    {
      "Name": "stats",
      "Description": "Show your server statistics",
      "Help": {
        "Usage": "/stats",
        "Details": [
          "Shows your personal tracked messages and voice time."
        ]
      }
    },
    {
      "Name": "server-statistics",
      "Description": "Generate a server activity statistics image.",
      "Help": {
        "Usage": "/server-statistics",
        "Details": [
          "Generates a branded image with the server logo, theme color, recent activity graph, activity score, global stats, and top 3 active members."
        ]
      }
    }
  ],
  "WebInterface": [
    {
      "Key": "TrackBots",
      "Type": "Boolean",
      "Label": "Include bot accounts in statistics",
      "Default": false,
      "Section": "Tracking"
    },
    {
      "Key": "IgnoredVoiceChannelIds",
      "Type": "List",
      "Label": "Ignored voice channels",
      "Default": [],
      "Section": "Tracking",
      "ItemType": "ChannelPicker",
      "SupportedChannelTypes": [
        "GuildVoice"
      ]
    },
    {
      "Key": "ActivityWindowDays",
      "Type": "Number",
      "Label": "Activity window in days",
      "Default": 30,
      "Section": "Activity status"
    },
    {
      "Key": "ActiveMessageThreshold",
      "Type": "Number",
      "Label": "Active message threshold",
      "Default": 20,
      "Section": "Activity status"
    },
    {
      "Key": "ActiveVoiceMinuteThreshold",
      "Type": "Number",
      "Label": "Active voice minute threshold",
      "Default": 60,
      "Section": "Activity status"
    },
    {
      "Key": "ActiveReactionThreshold",
      "Type": "Number",
      "Label": "Active reaction threshold",
      "Default": 10,
      "Section": "Activity status"
    },
    {
      "Key": "LowActivityMessageThreshold",
      "Type": "Number",
