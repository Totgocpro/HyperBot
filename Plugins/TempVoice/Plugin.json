{
  "Metadata": {
    "Id": "TempVoice",
    "DisplayName": "Temp Voice",
    "Version": "1.0.0",
    "Author": "HyperBot",
    "Icon": "TV"
  },
  "Scope": "Guild",
  "Commands": [],
  "WebInterface": [
    {
      "Key": "CreatorChannelId",
      "Type": "ChannelPicker",
      "Label": "Creator voice channel",
      "Default": "",
      "Section": "Creation",
      "SupportedChannelTypes": [
        "GuildVoice"
      ],
      "RequireWritable": false
    },
    {
      "Key": "ChannelNameTemplate",
      "Type": "String",
      "Label": "Temporary channel name",
      "Default": "%user%'s voice room",
      "Section": "Creation"
    },
    {
      "Key": "DefaultUserLimit",
      "Type": "Number",
      "Label": "Default user limit (0 = unlimited)",
      "Default": 0,
      "Section": "Creation"
    },
    {
      "Key": "DefaultBitrateKbps",
      "Type": "Number",
      "Label": "Default bitrate in Kbps",
      "Default": 64,
      "Section": "Creation"
    },
    {
      "Key": "LockEnabled",
      "Type": "Boolean",
      "Label": "Enable temporary room lock",
      "Default": true,
      "Section": "Owner controls"
    },
    {
      "Key": "BanEnabled",
      "Type": "Boolean",
      "Label": "Enable temporary room bans",
      "Default": true,
      "Section": "Owner controls"
    },
    {
      "Key": "ProtectedRoleIds",
      "Type": "List",
      "Label": "Roles protected from channel bans",
      "Default": [],
      "Section": "Protection",
      "ItemType": "RolePicker",
      "VisibleWhenAny": [
        {
          "Key": "BanEnabled",
          "Value": true
        }
      ]
    },
    {
      "Key": "ControlPanelTitle",
      "Type": "String",
      "Label": "Control panel title",
      "Default": "Temporary voice control panel",
      "Section": "Control panel"
    },
    {
      "Key": "ControlPanelDescription",
      "Type": "String",
      "Label": "Control panel description",
      "Default": "Only the current room owner can use these controls.",
      "Section": "Control panel"
    },
    {
      "Key": "ControlPanelColor",
      "Type": "String",
      "Label": "Control panel color",
      "Default": "#38bdf8",
      "Section": "Control panel"
    },
    {
      "Key": "MusicButtonPlayLabel",
      "Type": "String",
      "Label": "Play button label",
      "Default": "Play music",
      "Section": "Music"
    },
    {
      "Key": "MusicButtonPauseLabel",
      "Type": "String",
      "Label": "Pause button label",
      "Default": "Pause",
      "Section": "Music"
    },
    {
      "Key": "MusicButtonResumeLabel",
      "Type": "String",
      "Label": "Resume button label",
      "Default": "Continue",
      "Section": "Music"
    },
    {
      "Key": "MusicButtonSkipLabel",
      "Type": "String",
      "Label": "Skip button label",
      "Default": "Skip",
      "Section": "Music"
    },
    {
      "Key": "MusicButtonStopLabel",
      "Type": "String",
      "Label": "Stop button label",
      "Default": "Stop",
      "Section": "Music"
    },
    {
      "Key": "MusicAskButtonLabel",
      "Type": "String",
      "Label": "Ask music button label",
      "Default": "Ask music / playlist",
      "Section": "Music"
    },
    {
      "Key": "MusicModalTitle",
      "Type": "String",
      "Label": "Music modal title",
      "Default": "Play YouTube music",
      "Section": "Music"
    },
    {
      "Key": "MusicModalUrlLabel",
      "Type": "String",
      "Label": "Music URL input label",
      "Default": "YouTube video or playlist URL",
      "Section": "Music"
    },
    {
      "Key": "MusicAskModalTitle",
      "Type": "String",
      "Label": "Ask music modal title",
      "Default": "Ask music / playlist",
      "Section": "Music"
    },
    {
      "Key": "MusicAskSubmittedMessage",
      "Type": "String",
      "Label": "Ask music submitted message",
      "Default": "Music request sent to the room owner.",
      "Section": "Music messages"
    },
    {
      "Key": "MusicPanelEnabled",
      "Type": "Boolean",
      "Label": "Enable now playing image panel",
      "Default": true,
      "Section": "Music panel",
      "Description": "When music is playing, Temp Voice posts a private room message with a generated player image and edits it every 3.5 seconds."
    },
    {
      "Key": "MusicPanelAddButtonLabel",
      "Type": "String",
      "Label": "Waitlist button label",
      "Default": "Add to waitlist",
      "Section": "Music panel",
      "VisibleWhenAny": [
        {
          "Key": "MusicPanelEnabled",
          "Value": true
        }
      ]
    },
    {
      "Key": "MusicYoutubeAccountMode",
      "Type": "Select",
      "Label": "YouTube account linking",
      "Default": "Environment",
      "Section": "Music account",
      "Description": "Choose how Temp Voice authenticates YouTube extraction. Nothing from this setting is shown in Discord.",
      "Options": [
        {
          "Label": "Use bot environment",
          "Value": "Environment",
          "Description": "Uses TEMPVOICE_YOUTUBE_COOKIES_PATH or YOUTUBE_COOKIES_PATH from the bot process."
        },
        {
          "Label": "No linked account",
          "Value": "None",
          "Description": "Only public YouTube videos are playable."
        },
        {
          "Label": "Use server cookie file",
          "Value": "GuildFile",
          "Description": "Use a cookies.txt file path configured for this server."
        }
      ]
    },
    {
      "Key": "MusicYoutubeCookiesPath",
      "Type": "Password",
      "Label": "YouTube cookies file path",
      "Default": "",
      "Section": "Music account",
      "Description": "Absolute path on the bot host to a Netscape cookies.txt exported from the account to link. Do not paste cookie contents here.",
      "VisibleWhen": {
        "Key": "MusicYoutubeAccountMode",
        "Value": "GuildFile"
      }
    },
    {
      "Key": "MusicRequiresAccountMessage",
      "Type": "String",
      "Label": "Linked account required message",
      "Default": "This YouTube video is unavailable or requires a linked account.",
      "Section": "Music messages"
    },
    {
      "Key": "MusicStartedMessage",
      "Type": "String",
      "Label": "Music started message",
      "Default": "Music started: %title%%queued_suffix%.",
      "Section": "Music messages"
    },
    {
      "Key": "MusicBusyMessage",
      "Type": "String",
      "Label": "Music already playing message",
      "Default": "Music is already playing in %channel%.",
      "Section": "Music messages"
    },
    {
      "Key": "MusicControlAppliedMessage",
      "Type": "String",
      "Label": "Music control applied message",
      "Default": "Music control applied.",
      "Section": "Music messages"
    },
    {
      "Key": "MusicPlaybackFailedMessage",
      "Type": "String",
      "Label": "Music playback failed message",
      "Default": "Music playback failed: %error%",
      "Section": "Music messages"
    },
    {
      "Key": "MusicIdleStatus",
      "Type": "String",
      "Label": "Music idle status",
      "Default": "Idle",
      "Section": "Music messages"
    },
    {
      "Key": "MusicPlayingStatus",
      "Type": "String",
      "Label": "Music playing status",
      "Default": "Playing: %title%",
      "Section": "Music messages"
    },
    {
      "Key": "MusicPausedStatus",
      "Type": "String",
      "Label": "Music paused status",
      "Default": "Paused: %title%",
      "Section": "Music messages"
    },
    {
      "Key": "TTSEnabled",
      "Type": "Boolean",
      "Label": "Enable public TTS button",
      "Default": true,
      "Section": "TTS"
    },
    {
      "Key": "TTSButtonLabel",
      "Type": "String",
      "Label": "TTS button label",
      "Default": "TTS",
      "Section": "TTS",
      "VisibleWhenAny": [
        {
          "Key": "TTSEnabled",
          "Value": true
        } 
      ]
    },
    {
      "Key": "TTSDefaultLanguage",
      "Type": "String",
      "Label": "Default TTS language",
      "Default": "fr",
      "Section": "TTS",
      "VisibleWhenAny": [
        {
          "Key": "TTSEnabled",
          "Value": true
        } 
      ]
    },
    {
      "Key": "TTSModalTitle",
      "Type": "String",
      "Label": "TTS modal title",
      "Default": "Speak with TTS",
      "Section": "TTS",
      "VisibleWhenAny": [
        {
          "Key": "TTSEnabled",
          "Value": true
        } 
      ]
    },
    {
      "Key": "TTSModalTextLabel",
      "Type": "String",
      "Label": "TTS text input label",
      "Default": "Text to say",
      "Section": "TTS",
      "VisibleWhenAny": [
        {
          "Key": "TTSEnabled",
          "Value": true
        } 
      ]
    },
    {
      "Key": "TTSModalLanguageLabel",
      "Type": "String",
      "Label": "TTS language input label",
      "Default": "Language (fr, en, es...)",
      "Section": "TTS",
      "VisibleWhenAny": [
        {
          "Key": "TTSEnabled",
          "Value": true
        } 
      ]
    },
    {
      "Key": "TTSStartedMessage",
      "Type": "String",
      "Label": "TTS started message",
      "Default": "TTS started.",
      "Section": "TTS messages",
      "VisibleWhenAny": [
        {
          "Key": "TTSEnabled",
          "Value": true
        } 
      ]
    },
    {
      "Key": "TTSBusyMessage",
      "Type": "String",
      "Label": "TTS busy message",
      "Default": "The bot is already connected in %channel%.",
      "Section": "TTS messages",
      "VisibleWhenAny": [
        {
          "Key": "TTSEnabled",
          "Value": true
        } 
      ]
    },
    {
      "Key": "TTSDisabledMessage",
      "Type": "String",
      "Label": "TTS disabled message",
      "Default": "TTS is disabled on this server.",
      "Section": "TTS messages",
      "VisibleWhenAny": [
        {
          "Key": "TTSEnabled",
          "Value": true
        } 
      ]
    },
    {
      "Key": "TTSFailedMessage",
      "Type": "String",
      "Label": "TTS failed message",
      "Default": "TTS failed: %error%",
      "Section": "TTS messages",
      "VisibleWhenAny": [
        {
          "Key": "TTSEnabled",
          "Value": true
        } 
      ]
    }
  ],
  "EntryPoint": "./TempVoicePlugin.ts",
  "Category": "Voice"
}
