{
  "Metadata": {
    "Id": "Giveaway",
    "DisplayName": "Giveaway",
    "Version": "1.0.0",
    "Author": "HyperBot",
    "Icon": "GA"
  },
  "Scope": "Guild",
  "Help": {
    "Description": "Runs button-based giveaways with winner limits, role checks, bonus entry rules, messages, and button labels."
  },
  "Commands": [
    {
      "Name": "giveaway-start",
      "Description": "Start a giveaway with a join button.",
      "Options": [
        {
          "Name": "prize",
          "Description": "Prize to give away.",
          "Type": "String",
          "Required": true
        },
        {
          "Name": "duration",
          "Description": "Duration, for example 10m, 2h, 3d.",
          "Type": "String",
          "Required": true
        },
        {
          "Name": "winners",
          "Description": "Number of winners.",
          "Type": "Integer",
          "Required": true
        },
        {
          "Name": "channel",
          "Description": "Target channel. Defaults to the current channel.",
          "Type": "Channel",
          "Required": false
        }
      ]
    },
    {
      "Name": "giveaway-end",
      "Description": "End a giveaway immediately.",
      "Options": [
        {
          "Name": "message_id",
          "Description": "Giveaway message ID.",
          "Type": "String",
          "Required": true
        }
      ]
    },
    {
      "Name": "giveaway-reroll",
      "Description": "Reroll winners for an ended giveaway.",
      "Options": [
        {
          "Name": "message_id",
          "Description": "Giveaway message ID.",
          "Type": "String",
          "Required": true
        }
      ]
    },
    {
      "Name": "giveaway-list",
      "Description": "List active giveaways for this server."
    }
  ],
  "WebInterface": [
    {
      "Key": "DefaultChannelId",
      "Type": "ChannelPicker",
      "Label": "Default giveaway channel",
      "Default": "",
      "Section": "Defaults",
      "SupportedChannelTypes": [
        "GuildText",
        "GuildAnnouncement",
        "GuildVoice"
      ],
      "RequireWritable": true
    },
    {
      "Key": "DefaultDuration",
      "Type": "String",
      "Label": "Default duration",
      "Default": "1d",
      "Section": "Defaults"
    },
    {
      "Key": "DefaultWinnerCount",
      "Type": "Number",
      "Label": "Default winner count",
      "Default": 1,
      "Section": "Defaults"
    },
    {
      "Key": "MaxWinnerCount",
      "Type": "Number",
      "Label": "Maximum winner count",
      "Default": 20,
      "Section": "Defaults"
    },
    {
      "Key": "RequiredRoleIds",
      "Type": "List",
      "ItemType": "RolePicker",
      "Label": "Required roles",
      "Default": [],
      "Section": "Entry rules"
    },
    {
      "Key": "BlockedRoleIds",
      "Type": "List",
      "ItemType": "RolePicker",
      "Label": "Blocked roles",
      "Default": [],
      "Section": "Entry rules"
    },
    {
      "Key": "BonusEntryRules",
      "Type": "List",
      "ItemType": "String",
      "Label": "Bonus entry rules",
      "Default": [],
      "Section": "Entry rules"
    },
    {
      "Key": "GiveawayEmbed",
      "Type": "EmbedEditor",
      "Label": "Active giveaway embed",
      "Description": "Available tags: %prize%, %winnerCount%, %entries%, %host%, %hostTag%, %endsAt%, %messageId%.",
      "Default": {
        "Name": "Active giveaway",
        "Title": "Giveaway: %prize%",
        "Description": "Click the button below to enter. Ends %endsAt%.",
        "Color": "#5865f2",
        "Url": "",
        "AuthorName": "",
        "AuthorIconUrl": "",
        "ThumbnailUrl": "",
        "ImageUrl": "",
        "FooterText": "Hosted by %hostTag%",
        "FooterIconUrl": "",
        "Timestamp": true,
        "Fields": [
          {
            "Name": "Prize",
            "Value": "%prize%",
            "Inline": true
          },
          {
            "Name": "Winners",
            "Value": "%winnerCount%",
            "Inline": true
          },
          {
            "Name": "Entries",
            "Value": "%entries%",
            "Inline": true
          },
          {
            "Name": "Hosted by",
            "Value": "%host%",
            "Inline": true
          },
          {
            "Name": "Ends",
            "Value": "%endsAt%",
            "Inline": true
          }
        ],
        "ImageDataUrl": "",
        "ImageName": ""
      },
      "Section": "Messages"
    },
    {
      "Key": "EndedEmbed",
      "Type": "EmbedEditor",
      "Label": "Ended giveaway embed",
      "Description": "Available tags: %prize%, %winners%, %winnerCount%, %entries%, %host%, %hostTag%, %endsAt%, %messageId%.",
      "Default": {
        "Name": "Ended giveaway",
        "Title": "Giveaway: %prize%",
        "Description": "This giveaway has ended. Winners: %winners%.",
        "Color": "#22c55e",
        "Url": "",
        "AuthorName": "",
        "AuthorIconUrl": "",
        "ThumbnailUrl": "",
        "ImageUrl": "",
        "FooterText": "Hosted by %hostTag%",
        "FooterIconUrl": "",
        "Timestamp": true,
        "Fields": [
          {
            "Name": "Prize",
            "Value": "%prize%",
            "Inline": true
          },
          {
            "Name": "Winners",
            "Value": "%winnerCount%",
            "Inline": true
          },
          {
            "Name": "Entries",
            "Value": "%entries%",
            "Inline": true
          },
          {
            "Name": "Selected winner(s)",
            "Value": "%winners%",
            "Inline": false
          }
        ],
        "ImageDataUrl": "",
        "ImageName": ""
      },
      "Section": "Messages"
    },
    {
      "Key": "NoWinnerText",
      "Type": "String",
      "Label": "No winner text",
      "Default": "No valid winner could be selected.",
      "Section": "Messages"
    },
    {
      "Key": "WinnerAnnouncement",
      "Type": "String",
      "Label": "Winner announcement",
      "Default": "Congratulations %winners%! You won **%prize%**.",
      "Section": "Messages"
    },
    {
      "Key": "RerollAnnouncement",
      "Type": "String",
      "Label": "Reroll announcement",
      "Default": "New winner(s) for **%prize%**: %winners%.",
      "Section": "Messages"
    },
    {
      "Key": "JoinButtonLabel",
      "Type": "String",
      "Label": "Join button label",
      "Default": "Enter giveaway",
      "Section": "Button"
    },
    {
      "Key": "LeaveButtonLabel",
      "Type": "String",
      "Label": "Leave button label",
      "Default": "Leave giveaway",
      "Section": "Button"
    },
    {
      "Key": "EntryAcceptedMessage",
      "Type": "String",
      "Label": "Entry accepted message",
      "Default": "You entered the giveaway.",
      "Section": "Button"
    },
    {
      "Key": "EntryRemovedMessage",
      "Type": "String",
      "Label": "Entry removed message",
      "Default": "Your giveaway entry was removed.",
      "Section": "Button"
    },
    {
      "Key": "NotEligibleMessage",
      "Type": "String",
      "Label": "Not eligible message",
      "Default": "You are not eligible for this giveaway.",
      "Section": "Button"
    }
  ],
  "EntryPoint": "./GiveawayPlugin.ts",
  "Category": "Engagement"
}
