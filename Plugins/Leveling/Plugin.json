{
  "Metadata": {
    "Id": "Leveling",
    "DisplayName": "Leveling",
    "Version": "1.0.0",
    "Author": "HyperBot",
    "Icon": "LV"
  },
  "Scope": "Guild",
  "Help": {
    "Description": "Awards XP from counted messages and voice minutes, then displays a public leaderboard."
  },
  "Dependencies": [
    "Statistics"
  ],
  "Commands": [
    {
      "Name": "leaderboard",
      "Description": "Show the public XP leaderboard."
    }
  ],
  "WebInterface": [
    {
      "Key": "MessageXp",
      "Type": "Number",
      "Label": "XP per counted message",
      "Default": 5,
      "Section": "XP rules"
    },
    {
      "Key": "VoiceMinuteXp",
      "Type": "Number",
      "Label": "XP per counted voice minute",
      "Default": 2,
      "Section": "XP rules"
    },
    {
      "Key": "LeaderboardSize",
      "Type": "Number",
      "Label": "Leaderboard size",
      "Default": 10,
      "Section": "Leaderboard"
    },
    {
      "Key": "LeaderboardTitle",
      "Type": "String",
      "Label": "Leaderboard title",
      "Default": "Server XP leaderboard",
      "Section": "Leaderboard text"
    },
    {
      "Key": "LeaderboardDescription",
      "Type": "String",
      "Label": "Leaderboard description",
      "Default": "XP is calculated from valid messages and counted voice time.",
      "Section": "Leaderboard text"
    },
    {
      "Key": "LeaderboardEmptyText",
      "Type": "String",
      "Label": "Empty leaderboard text",
