    {
      "Key": "LeaderboardFooterText",
      "Type": "String",
      "Label": "Leaderboard footer text",
      "Default": "Messages deleted after tracking are removed from XP.",
      "Section": "Leaderboard text"
    },
    {
      "Key": "LeaderboardEmbedColor",
      "Type": "String",
      "Label": "Leaderboard embed color",
      "Default": "#f59e0b",
      "Section": "Design"
    }
  ],
  "EntryPoint": "./LevelingPlugin.ts",
  "Category": "Engagement"
}
