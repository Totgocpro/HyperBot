{
  "Metadata": {
    "Id": "DiscordGame",
    "DisplayName": "Discord Game",
    "Version": "1.0.0",
    "Author": "HyperBot",
    "Icon": "DG"
  },
  "Scope": "Guild",
  "Commands": [
    {
      "Name": "minesweeper",
      "Description": "Start a Discord Minesweeper game.",
      "Options": [
        {
          "Name": "difficulty",
          "Description": "Choose the number of mines.",
          "Type": "String",
          "Required": true,
          "Choices": [
            {
              "Name": "Easy",
              "Value": "Easy"
            },
            {
              "Name": "Medium",
              "Value": "Medium"
            },
            {
              "Name": "Hard",
              "Value": "Hard"
            }
          ]
        }
      ]
    },
    {
      "Name": "tictactoe",
      "Description": "Start a Tic-Tac-Toe game against the bot.",
      "Options": [
        {
          "Name": "difficulty",
          "Description": "Choose the bot difficulty.",
          "Type": "String",
          "Required": true,
          "Choices": [
            {
              "Name": "Easy",
              "Value": "Easy"
            },
            {
              "Name": "Medium",
              "Value": "Medium"
            },
            {
              "Name": "Impossible",
              "Value": "Impossible"
            }
          ]
        }
      ]
    }
  ],
  "WebInterface": [
    {
      "Key": "MinesweeperTitle",
      "Type": "String",
      "Label": "Minesweeper title",
      "Default": "Minesweeper - %difficulty%",
      "Section": "Minesweeper"
    },
    {
      "Key": "MinesweeperDescription",
      "Type": "String",
      "Label": "Minesweeper description",
      "Default": "Reveal every safe tile without clicking a mine. Mines: %mines%",
      "Section": "Minesweeper"
    },
    {
      "Key": "MinesweeperWinMessage",
      "Type": "String",
      "Label": "Win message",
      "Default": "%user% cleared the minefield.",
      "Section": "Minesweeper"
    },
    {
      "Key": "MinesweeperLoseMessage",
      "Type": "String",
      "Label": "Lose message",
      "Default": "%user% clicked a mine.",
      "Section": "Minesweeper"
    },
    {
      "Key": "MinesweeperTimeoutMessage",
      "Type": "String",
      "Label": "Timeout message",
      "Default": "This Minesweeper game timed out after %timeoutMinutes% minutes without input.",
      "Section": "Minesweeper"
    },
    {
      "Key": "MinesweeperUnauthorizedMessage",
      "Type": "String",
