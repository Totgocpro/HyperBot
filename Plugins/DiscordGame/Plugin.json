{
  "Metadata": {
    "Id": "DiscordGame",
    "DisplayName": "Discord Game",
    "Version": "1.0.0",
    "Author": "HyperBot",
    "Icon": "DG"
  },
  "Scope": "Guild",
  "Help": {
    "Description": "Provides Discord games and generated image interactions."
  },
  "Commands": [
    {
      "Name": "minesweeper",
      "Description": "Start a Discord Minesweeper game.",
      "Options": [
        {
          "Name": "difficulty",
          "Description": "Choose the number of mines.",
          "Type": "String",
          "Required": true,
          "Choices": [
            {
              "Name": "Easy",
              "Value": "Easy"
            },
            {
              "Name": "Medium",
              "Value": "Medium"
            },
            {
              "Name": "Hard",
              "Value": "Hard"
            }
          ]
        }
      ]
    },
    {
      "Name": "tictactoe",
      "Description": "Start a Tic-Tac-Toe game against the bot.",
      "Options": [
        {
          "Name": "difficulty",
          "Description": "Choose the bot difficulty.",
          "Type": "String",
          "Required": true,
          "Choices": [
            {
              "Name": "Easy",
              "Value": "Easy"
            },
            {
              "Name": "Medium",
              "Value": "Medium"
            },
            {
              "Name": "Impossible",
              "Value": "Impossible"
            }
          ]
        }
      ]
    },
    {
      "Name": "love",
      "Description": "Generate a love compatibility image for two server members.",
      "Options": [
        {
          "Name": "first_member",
          "Description": "First member.",
          "Type": "User",
          "Required": true
        },
        {
          "Name": "second_member",
          "Description": "Second member.",
          "Type": "User",
          "Required": true
        }
      ]
    },
    {
      "Name": "askyes",
      "Description": "Ask a yes/no question and get a random image answer.",
      "Options": [
        {
          "Name": "question",
          "Description": "Question to answer.",
          "Type": "String",
          "Required": true
        }
      ]
    }
  ],
