{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/Core/**/*.ts", "src/Bot/**/*.ts", "Plugins/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist", "app/**/*.tsx", "src/Web/**/*.tsx"]
}
